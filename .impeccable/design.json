  "narrative": {
    "northStar": "工业安全现场",
    "overview": "这是一块为巡检机器人的二维地图仿真控制台定制的「工业安全现场」界面：明亮的浅灰现场底上，用安全琥珀、信号绿、信号红三种语义色做状态与动作，用警戒带、信号灯、仪器读数这些真实工业现场的物件语言组织界面，而不是用装饰性渐变或柔和圆角「美化」它。\n\n界面的气质是「明确、实心、像现场设备」：每一个可交互元素都有清晰的几何轮廓、可见的状态变化和明确的语义色。信息以「读出行」的仪器面板形式成组呈现，数字一律等宽、可对齐，像工业仪表读数一样稳定。密度中等偏紧，适合桌面监控与投影演示。",
    "keyCharacteristics": [
      "三种安全信号色各司其职：琥珀（主 accent/警示）、绿（运行/开始）、红（危险/故障）",
      "警戒带（黄黑斜纹）与信号灯是贯穿全场的视觉签名",
      "等宽数字读数（仪器面板质感），信息按「读出行」成组",
      "明亮浅底 + 深墨色文字，对比清晰，适合明亮环境"
    ],
    "rules": [
      { "name": "The One-Accent Rule", "body": "安全琥珀是唯一的「强调」色，仅出现在激活/警示/悬停这些需要引起注意的瞬间；大面积填充只允许信号绿（开始）与信号红（危险）这两个语义明确的动作色。琥珀的稀缺正是它的意义。", "section": "colors" },
      { "name": "The Semantic-Color Rule", "body": "绿=运行/开始，红=危险/故障，琥珀=警示/激活。同一语义永不换色。", "section": "colors" },
      { "name": "The Instrument-Readout Rule", "body": "凡是数字，必用等宽 + tabular-nums，让它像仪表读数一样对齐稳定；文字用系统无衬线，绝不混用。", "section": "typography" },
      { "name": "The Flat-By-Default Rule", "body": "界面以浅底 + 1px 边框的「平面分层」为主，阴影只用于地图框与主按钮这两个需要「浮起」的焦点，作为响应式反馈而非装饰。", "section": "elevation" },
      { "name": "The Soft-Square Rule", "body": "直角被压成 12–14px 的轻微圆角，整体仍是方正、像设备外壳的几何；只有指示灯与状态胶囊是正圆。", "section": "shapes" }
    ],
    "dos": [
      "用等宽 + tabular-nums 渲染所有数值读数。",
      "用语义色（绿/红/琥珀）表达状态，且同一语义始终用同一色。",
      "给每个交互元素 44px 以上的点击区域和清晰的 :focus-visible 琥珀环。",
      "用警戒带 + 信号灯这两处签名贯穿页面，而不是引入新的装饰图案。"
    ],
    "donts": [
      "不使用渐变文字、玻璃模糊、彩色侧边条或 >1px 的彩色边框装饰。",
      "不用 emoji 或 Unicode 符号当图标，统一用描边一致的 SVG。",
      "不把等宽字体当作「技术感」用在代码/数据/测量之外的文字上。",
      "不引入纯灰阶或纯黑白的第三套色，所有中性色都从现场工装的墨蓝色相调出。",
      "不用硬偏移阴影（4px 4px 0）或 sparkline/进度环/软圆角矩形当作内容容器。"
    ]
  }
}
